# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE OAUTH 2.0 CREDENTIALS:
# Configure in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URIs:
# Development: https://ais-dev-3hfjlmailaldv627ddoosv-112527810767.asia-southeast1.run.app/auth/google/callback
# Shared/Deployed: https://ais-pre-3hfjlmailaldv627ddoosv-112527810767.asia-southeast1.run.app/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# SMTP_USER: Gmail address for real email OTP and verification link dispatch
SMTP_USER="trustpro.web3@gmail.com"

# SMTP_PASS: Gmail App Password for Nodemailer
SMTP_PASS="aqwxlfhzpcrizpog"
